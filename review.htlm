<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Product Review Confirmation Page">
    <meta name="author" content="Alagbaoso Solomon Ginikachukwu">

    <title>Review Submitted</title>

    <link rel="stylesheet" href="styles/form.css">
    <link rel="stylesheet" href="styles/form-large.css">

    <script src="scripts/review.js" defer></script>
</head>

<body>

<header>
    <h1>Review Submitted Successfully!</h1>
    <p>Thank you for taking the time to review our product.</p>
</header>

<main>

    <section class="confirmation">

        <h2>Thank You!</h2>

        <p>
            Your review has been received successfully.
        </p>

        <p>
            We appreciate your feedback. Your comments help us improve our
            products and provide better experiences for our customers.
        </p>

        <hr>

        <h3>Review Statistics</h3>

        <p>
            Total Reviews Submitted:
            <strong id="reviewCount">0</strong>
        </p>

        <hr>

        <p>
            Want to submit another review?
        </p>

        <a class="button" href="form.html">
            Submit Another Review
        </a>

    </section>

</main>

<footer>

    <p>
        &copy;
        <span id="currentyear"></span>
        🌿
        Alagbaoso Solomon Ginikachukwu
        🌿
        Nigeria
    </p>

    <p id="lastModified"></p>

</footer>
</body>
</html>